# Normalise line endings to LF in the repository and in working trees, so that
# the tests see the same bytes on Windows and on Linux.
* text=auto eol=lf

# Binary assets.
*.jpg binary
*.jpeg binary
*.png binary
*.heic binary
*.heif binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
