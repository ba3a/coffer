{% extends "base.njk" %}

{% block main %}
{% block heading %}
<h1>{{ page.title }}</h1>
{% if tagsUrl %}<p class="tags-link"><a href="{{ tagsUrl | url }}">{{ 'tags.title' | t }}</a></p>
{% endif %}
{% endblock %}
{% block feed_link %}
{% if pageFeed %}<p class="feed-link"><a rel="alternate" type="application/atom+xml" href="{{ pageFeed.url | url }}">{{ pageFeed.title }}</a></p>
{% endif %}
{% endblock %}
{% if posts.length %}
<ol class="post-list">
{% for post in posts %}
<li class="post-item">
{% block item %}
{% if post.index == 'full' %}
<h2><a href="{{ post.url | url }}">{{ post.title }}</a></h2>
<p class="post-meta">
<time datetime="{{ post.date | date('iso') }}">{{ post.date | date }}</time>
<span aria-hidden="true">&middot;</span>
<span class="reading-time">{{ 'post.reading_time' | t({ count: post.readingMinutes }) }}</span>
</p>
{% if post.tagLinks.length %}
<ul class="post-tags" aria-label="{{ 'tags.post_tags' | t }}">
{% for tag in post.tagLinks %}
<li><a href="{{ tag.url | url }}">{{ tag.name }}</a></li>
{% endfor %}
</ul>
{% endif %}
{% include "partials/banner.njk" %}
<div class="post-body">{{ post.html | safe }}</div>
{% else %}
<h2><a href="{{ post.url | url }}">{{ post.title }}</a></h2>
<p class="post-meta">
<time datetime="{{ post.date | date('iso') }}">{{ post.date | date }}</time>
<span aria-hidden="true">&middot;</span>
<span class="reading-time">{{ 'post.reading_time' | t({ count: post.readingMinutes }) }}</span>
</p>
{% if post.summary %}<p class="post-summary">{{ post.summary }}</p>
{% endif %}
{% include "partials/banner.njk" %}
{% endif %}
{% endblock %}
</li>
{% endfor %}
</ol>
{% block pagination %}
{% if pagination %}
<nav class="pagination" aria-label="{{ 'pagination.label' | t }}">
<ul>
{% if pagination.previous %}<li class="pagination-previous"><a rel="prev" href="{{ pagination.previous | url }}">{{ 'pagination.previous' | t }}</a></li>
{% endif %}
<li class="pagination-current" aria-current="page">{{ 'pagination.page' | t({ page: pagination.page, pages: pagination.pages }) }}</li>
{% if pagination.next %}<li class="pagination-next"><a rel="next" href="{{ pagination.next | url }}">{{ 'pagination.next' | t }}</a></li>
{% endif %}
</ul>
</nav>
{% endif %}
{% endblock %}
{% else %}
<p class="empty">{{ 'blog.empty' | t }}</p>
{% endif %}
{% endblock %}
