{% extends "base.njk" %}
{% from "series-nav.njk" import seriesNav %}

{% block main %}
<article class="post">
<header class="post-header">
{% block project_badges %}
{% if projectBlocks.length %}
<ul class="project-badges" aria-label="{{ 'post.projects' | t }}">
{% for badge in projectBlocks %}
<li><a class="project-badge" href="{{ badge.url | url }}">{{ badge.name }}</a></li>
{% endfor %}
</ul>
{% endif %}
{% endblock %}
<h1>{{ page.title }}</h1>
{% block meta %}
<p class="post-meta">
<time datetime="{{ post.date | date('iso') }}">{{ 'post.published' | t({ date: (post.date | date) }) }}</time>
<span aria-hidden="true">&middot;</span>
<span class="reading-time">{{ 'post.reading_time' | t({ count: post.readingMinutes }) }}</span>
</p>
{% endblock %}
{% block tags %}
{% if post.tagLinks.length %}
<ul class="post-tags" aria-label="{{ 'tags.post_tags' | t }}">
{% for tag in post.tagLinks %}
<li><a href="{{ tag.url | url }}">{{ tag.name }}</a></li>
{% endfor %}
</ul>
{% endif %}
{% endblock %}
{% block series_top %}
{% if series %}{{ seriesNav(series, 'top') }}{% endif %}
{% endblock %}
{% include "partials/banner.njk" %}
</header>
<div class="post-layout{% if toc.length %} has-toc{% endif %}">
{% if toc.length %}
{% block toc %}{% include "partials/toc.njk" %}{% endblock %}
{% endif %}
<div class="post-body" data-pagefind-body data-pagefind-filter="blog:{{ blog.id }}">
{% block body %}{{ page.content | safe }}{% endblock %}
</div>
</div>
{% block series_bottom %}
{% if series %}{{ seriesNav(series, 'bottom') }}{% endif %}
{% endblock %}
{# One block for each project the post is about, at the very end of the post. #}
{% block project_blocks %}
{% for project in projectBlocks %}
{% include "partials/project-block.njk" %}
{% endfor %}
{% endblock %}
{# The share summary, collapsed, at the very end of the post (only on a blog that has `shareSummary`). #}
{% block share %}
{% if share %}{% include "partials/share.njk" %}{% endif %}
{% endblock %}
</article>
{% endblock %}
