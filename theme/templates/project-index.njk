{% extends "base.njk" %}

{% block main %}
{% block heading %}
<h1>{{ page.title }}</h1>
{% endblock %}
{% if projects.length %}
<ul class="project-cards">
{% for project in projects %}
<li>
{% set level = 2 %}
{% include "project-card.njk" %}
</li>
{% endfor %}
</ul>
{% else %}
<p class="empty">{{ 'projects.empty' | t }}</p>
{% endif %}
{% endblock %}
